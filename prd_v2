### 10.2 A/B Test Implementation Structure

```javascript
// Simple A/B test wrapper
const useABTest = (testName, variants) => {
  // Randomly assign variant (in production: use proper A/B tool)
  const variant = useMemo(() => {
    const saved = localStorage.getItem(`ab_${testName}`);
    if (saved) return saved;
    
    const random = variants[Math.floor(Math.random() * variants.length)];
    localStorage.setItem(`ab_${testName}`, random);
    return random;
  }, [testName]);
  
  return variant;
};

// Usage example
const CTAButton = () => {
